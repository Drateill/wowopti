# Copie ce fichier en .env.local puis remplis-le.
# Clés à créer sur https://develop.battle.net/access/clients (bouton « Create Client »).
# Ces valeurs restent sur ton PC : seul le serveur de dev les lit, le navigateur ne les voit jamais.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# eu ou us
BLIZZARD_REGION=eu
# Facultatif : force un namespace (ex. static-1.60.1_70399-forever-eu) si la détection automatique échoue.
BLIZZARD_NAMESPACE=
